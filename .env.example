# No API keys required — all data sources are public
# Optional: add keys below to unlock higher rate limits

# API-Football (api-sports.io) — free 100 req/day
# API_FOOTBALL_KEY=

# The Odds API (the-odds-api.com) — free 500 req/month
# ODDS_API_KEY=

# NewsAPI (newsapi.org) — free 100 req/day, fallback to Google News RSS if absent
# NEWS_API_KEY=

# ── Polymarket execution (optional) ────────────────────────────────────────────
# Required ONLY if you want to place bets directly from the dashboard.
# Without these, EdgeFinder works fully for predictions — just no direct execution.
# Get your API key at: https://docs.polymarket.com/#authentication
# POLY_PRIVATE_KEY=your_polygon_wallet_private_key_hex
# POLY_API_KEY=your_polymarket_api_key
# POLY_API_SECRET=your_polymarket_api_secret
# POLY_API_PASSPHRASE=your_polymarket_api_passphrase

# Hard cap on a single bet placed via the `place <id>` REPL command (USDC). Default 100.
# MAX_BET_USDC=100

# ── LLM verdict (optional, enables the `ask` command) ───────────────────────────────────
# Without this, predictions still work — you just don't get the BET/SKIP/MARGINAL summary.
# Get a key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
