# No API keys required — all data sources are public
# Optional: add keys below to unlock higher rate limits

# API-Football (api-sports.io) — free 100 req/day
# API_FOOTBALL_KEY=

# The Odds API (the-odds-api.com) — free 500 req/month
# ODDS_API_KEY=

# NewsAPI (newsapi.org) — free 100 req/day, fallback to Google News RSS if absent
# NEWS_API_KEY=
